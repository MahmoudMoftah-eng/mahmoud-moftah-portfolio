---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import {site, url} from '../data/site';
---
<BaseLayout title="About Mahmoud Moftah | Mechatronics Engineering Student" description="Mechatronics Engineering student at SUBÜ, developing embedded systems, control software and autonomous UAV systems. Expected graduation July 2027.">
  <header class="shell about-hero">
    <div class="about-content">
      <figure class="about-photo">
        <img src={url('images/about-conference.jpg')} alt="Mahmoud Moftah at the TEKNOFEST 2026 Fighter UAV event area." width="4032" height="3024"/>
      </figure>
      <div class="about-introduction">
        <p class="eyebrow">About Mahmoud Moftah</p>
        <h1>I’m drawn to engineering where control software meets real hardware.</h1>
        <div class="about-copy">
          <p>My strongest practical experience comes from UAV and embedded-control projects, where software interacts with real hardware, sensors, flight controllers and safety constraints. My project work covers embedded firmware, guidance and control, autonomous mission logic and system integration.</p>
          <p>I’m interested in aerospace, autonomous systems, robotics and defense technologies. I value careful implementation and testing as much as the algorithm itself, while continuing to develop my knowledge of Embedded Linux, PCB design, C / C++ and real-time embedded systems.</p>
        </div>
        <div class="about-action">
          <Button href={`mailto:${site.email}`}><Icon name="mail" size={18}/>Email Mahmoud</Button>
        </div>
      </div>
    </div>
  </header>
</BaseLayout>

<style>
  .about-hero {
    padding-block: 48px 72px;
  }

  .about-content {
    width: min(100%, 1080px);
    margin-inline: auto;
  }

  .about-introduction {
    min-width: 0;
    max-width: 900px;
    margin-top: 44px;
  }

  .about-introduction h1 {
    max-width: 820px;
    margin-top: 20px;
    font-size: clamp(2.65rem, 4.7vw, 4.2rem);
    line-height: 1.12;
    letter-spacing: -0.018em;
  }

  .about-copy {
    max-width: 720px;
    margin-top: 29px;
  }

  .about-copy p {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.85;
  }

  .about-copy p + p {
    margin-top: 18px;
  }

  .about-action {
    margin-top: 29px;
  }

  .about-photo {
    margin: 0;
  }

  .about-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .about-hero {
      padding-block: 40px 58px;
    }

    .about-introduction {
      margin-top: 36px;
    }
  }

  @media (max-width: 600px) {
    .about-hero {
      padding-block: 30px 48px;
    }

    .about-introduction {
      margin-top: 28px;
    }

    .about-introduction h1 {
      margin-top: 17px;
      font-size: 2.125rem;
      line-height: 1.18;
    }

    .about-copy {
      margin-top: 24px;
    }

    .about-copy p {
      line-height: 1.78;
    }

    .about-action {
      margin-top: 25px;
    }
  }
</style>
