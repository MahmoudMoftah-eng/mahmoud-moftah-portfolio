---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TechBadge from '../components/TechBadge.astro';
import {experience} from '../data/experience';
---
<BaseLayout title="About Mahmoud Moftah | Mechatronics Engineering Student" description="Mechatronics Engineering student at SUBÜ, developing embedded systems, control software and autonomous UAV systems. Expected graduation July 2027."><header class="shell page-hero"><p class="eyebrow">ABOUT / MAHMOUD MOFTAH MOHAMED</p><h1>Where software meets<br/><span class="accent-text">the physical world.</span></h1><p class="page-intro">Mechatronics Engineering student at Sakarya University of Applied Sciences, interested in the intersection of embedded systems, control theory and autonomous machines.</p></header><section class="shell about-layout"><div class="prose"><h2>An engineering perspective.</h2><p>My strongest practical experience comes from UAV projects, where software interacts with real hardware, sensors, flight controllers and safety constraints. I work on embedded firmware, guidance and control, autonomous mission logic and system integration.</p><p>I’m interested in engineering for aerospace, autonomous systems, robotics and defense technologies. I’m looking to contribute to teams where careful implementation and testing matter as much as the algorithm itself.</p><p>I actively develop my knowledge of Embedded Linux, PCB design, C / C++ and real-time embedded systems. These remain learning directions alongside my hands-on project work.</p><h3>Roles I’m interested in</h3><div class="badges">{['Embedded Systems','Flight Control','Guidance / Navigation','Autonomous Systems','Robotics'].map(label=><TechBadge label={label}/>)}</div></div><aside class="about-facts"><p class="eyebrow">AT A GLANCE</p><dl><dt>STUDYING</dt><dd>B.Sc. Mechatronics Engineering</dd><dt>UNIVERSITY</dt><dd>Sakarya University of Applied Sciences — SUBÜ</dd><dt>LOCATION</dt><dd>Sakarya, Türkiye</dd><dt>EXPECTED GRADUATION</dt><dd>July 2027</dd></dl></aside></section><section class="shell section" id="experience"><SectionHeading label="EXPERIENCE" title="Built with a team."/>{experience.map(item=><ExperienceItem item={item}/>)}</section><ContactCTA/></BaseLayout>
