---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHero from '../../components/ProjectHero.astro';
import ProjectSection from '../../components/ProjectSection.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import AbraArchitecture from '../../components/AbraArchitecture.astro';
import TechBadge from '../../components/TechBadge.astro';
import {projects,sectionId,type Project} from '../../data/projects';
import {url} from '../../data/site';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
interface Props {project:Project}
const {project} = Astro.props;
const next = projects[(projects.findIndex(p=>p.slug===project.slug)+1)%projects.length];
const hasProjectMedia = project.media.some(media => Boolean(media.src)) || Boolean(project.github) || Boolean(project.video);
---
<BaseLayout title={`${project.shortTitle} — ${project.role} | Mahmoud Moftah`} description={project.summary}>
<ProjectHero project={project}/>
<div class="shell case-layout"><aside class="case-sidebar"><nav aria-label="Case study contents"><p class="eyebrow">IN THIS CASE STUDY</p><ol>{project.sections.map(s=><li><a href={`#${sectionId(s.title)}`}>{s.title}</a></li>)}<li><a href="#technologies">Technologies</a></li>{hasProjectMedia && <li><a href="#project-media">Project media</a></li>}</ol></nav><div class="ownership-note"><span class="small-label">CONTRIBUTION NOTE</span><p>Work is described according to my role. Team contributions and ongoing work are identified separately.</p></div></aside><article class="case-content" aria-label={`${project.shortTitle} case study`}>
{project.sections.map(section => <ProjectSection section={section}>{project.slug === 'abra-hunter' && section.title === 'System Architecture' && <AbraArchitecture/>}</ProjectSection>)}
<section class="case-section" id="technologies"><h2>Technologies</h2><div class="badges">{project.technologies.map(label=><TechBadge label={label}/>)}</div></section>
{hasProjectMedia && <section class="case-section" id="project-media"><h2>Project media & evidence</h2><div class="media-grid">{project.media.filter(media => media.src).map(media=><MediaPlaceholder media={media} directory={project.mediaDirectory}/>)}</div>{project.github && <a class="text-link" href={project.github} target="_blank" rel="noopener noreferrer">Project source (opens in a new tab)</a>}{project.video && <a class="text-link" href={project.video} target="_blank" rel="noopener noreferrer">Project video (opens in a new tab)</a>}</section>}
</article></div><nav class="shell next-project" aria-label="More projects"><a class="text-link" href={url('projects/')}>All projects</a><a href={url(`projects/${next.slug}/`)}><span class="eyebrow">NEXT CASE STUDY</span><h3>{next.shortTitle}</h3></a></nav>
</BaseLayout>
