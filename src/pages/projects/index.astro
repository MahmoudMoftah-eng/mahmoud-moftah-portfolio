---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import {projects} from '../../data/projects';

// Use existing field photography in the project index; case-study data stays unchanged.
const projectPreviews = projects.map(project => ({
  ...project,
  heroImage: project.slug === 'abra-hunter'
    ? 'projects/abra/abra-aircraft-overview.jpg'
    : project.slug === 'yutpa-uav'
      ? 'projects/yutpa/yutpa-field-test.jpg'
      : project.heroImage,
}));
---
<BaseLayout title="Engineering Projects | Mahmoud Moftah" description="Explore embedded firmware, UAV guidance and control, autonomous mission software and ROS2 simulation projects by Mahmoud Moftah."><header class="shell page-hero"><p class="eyebrow">PROJECT INDEX / 01—04</p><h1>Engineering in practice.</h1><p class="page-intro">From control algorithms to hardware integration. A closer look at the systems I’ve worked on, my contribution, and the engineering behind them.</p></header><section class="shell projects-index" aria-label="Engineering projects"><div class="project-grid">{projectPreviews.map((p,i) => <ProjectCard project={p} number={i+1} showDiagram={!['stm32-robot-arm','yutpa-uav'].includes(p.slug)} imageAlt={p.slug === 'abra-hunter' ? 'ABRA Hunter UAV on the ground during field testing at sunset.' : p.slug === 'yutpa-uav' ? 'YUTPA UAV during field testing.' : undefined} imageClass={p.slug === 'yutpa-uav' ? 'project-image-yutpa' : undefined}/>)}</div></section><section class="shell section secondary-work"><p class="eyebrow">ADDITIONAL WORK & LEARNING</p><h2>Continuing to build.</h2><div class="learning-grid"><article><span class="small-label">AUTOMATION PROJECT</span><h3>Industrial automation</h3><p>Conveyor sorting and palletizing automation with Siemens S7-1214C, TIA Portal, Factory IO, Ladder Logic and HMI.</p></article><article><span class="small-label">CURRENT COURSEWORK</span><h3>PCB design</h3><p>Developing skills in Altium Designer, schematic design, component libraries, footprints and PCB layout.</p><span class="todo-note">Learning in progress</span></article><article><span class="small-label">STRUCTURED LEARNING</span><h3>Embedded Linux</h3><p>Building knowledge of Linux, C / C++, Bash and Raspberry Pi, with Yocto, device drivers, Docker and CI/CD as learning directions.</p><span class="todo-note">Learning in progress</span></article></div></section><ContactCTA/></BaseLayout>
