---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import SocialLinks from '../components/SocialLinks.astro';
import {projects} from '../data/projects';
import {experience} from '../data/experience';
import {site, url} from '../data/site';

// Homepage summaries leave the full project data and case studies unchanged.
const selectedProjects = projects
  .filter(project => ['abra-hunter', 'yutpa-uav'].includes(project.slug))
  .map(project => {
    if (project.slug === 'abra-hunter') return {
      ...project,
      heroImage: 'projects/abra/abra-aircraft-overview.jpg',
      summary: 'Guidance and cascaded control integrated with Betaflight ANGLE mode, supported by flight testing and flight-log analysis.',
    };
    if (project.slug === 'yutpa-uav') return {
      ...project,
      heroImage: 'projects/yutpa/yutpa-field-test.jpg',
    };
    return {...project};
  });

const homepageExperience = experience.map(item => ({
  ...item,
  summary: item.team === 'ABRA Student Team'
    ? 'Guidance & Control Lead for ABRA Hunter and Autonomous Flight Software Engineer for YUTPA.'
    : 'Developed the ROS2/Gazebo environment and integrated models and sensors to support localization, SLAM and navigation testing; member of the team awarded TEKNOFEST “Best Software Team”.',
}));

const homepageSkills = [
  {
    name: 'Embedded Systems & Electronics',
    items: 'STM32 · Embedded C firmware · Timers / interrupts · PWM / UART · Motor control / H-Bridge · ST-Link / Logic Analyzer',
  },
  {
    name: 'Control & Guidance',
    items: 'PID / cascade control · System identification · Pure Pursuit · Proportional Navigation · MATLAB / Simulink · Flight-log analysis',
  },
  {
    name: 'UAV & Robotics',
    items: 'Betaflight · ArduPilot · MAVLink / pymavlink · SITL · Mission Planner · ROS2 / Gazebo',
  },
  {
    name: 'Programming & Engineering Tools',
    items: 'Python · Git / GitHub · Linux · STM32CubeIDE / CubeMX',
    learning: 'Ongoing learning: broader C/C++ development and Embedded Linux.',
  },
];
---
<BaseLayout>
  <div class="homepage">
    <section class="shell hero">
      <div class="hero-copy">
        <p class="eyebrow">Mechatronics Engineering Student</p>
        <p class="hero-name">{site.name}</p>
        <h1>Embedded Systems · Control<br/><span>Autonomous Systems</span></h1>
        <p class="hero-description">Developing embedded firmware and UAV guidance and mission software through hardware integration, simulation and flight testing.</p>
        <p class="hero-meta">{site.location} · Expected graduation July 2027</p>
        <div class="hero-actions">
          <Button href={url('projects/')}>View Projects</Button>
          <Button href={url(site.cvAvailable ? site.cv : 'cv/')} secondary download={site.cvAvailable}>
            <Icon name="download" size={17}/>Download CV
          </Button>
        </div>
        <SocialLinks/>
      </div>
    </section>

    <section class="shell section" id="projects" aria-labelledby="projects-title">
      <div class="section-heading">
        <h2 id="projects-title">Selected Projects</h2>
        <a class="text-link" href={url('projects/')}>All projects</a>
      </div>
      <div class="project-grid selected-projects-grid">
        {selectedProjects.map((project, i) => (
          <ProjectCard project={project} number={i + 1} showDiagram={false}
            imageAlt={project.slug === 'abra-hunter' ? 'ABRA Hunter UAV on the ground during field testing at sunset.' : project.slug === 'yutpa-uav' ? 'YUTPA UAV during field testing.' : undefined}
            imageClass={project.slug === 'yutpa-uav' ? 'project-image-yutpa' : undefined}/>
        ))}
      </div>
    </section>

    <section class="shell section" id="experience" aria-labelledby="experience-title">
      <div class="section-heading"><h2 id="experience-title">Experience</h2></div>
      {homepageExperience.map(item => <ExperienceItem item={item}
        logo={item.team === 'ABRA Student Team' ? 'images/abra-team-logo.jpg' : 'images/ytg-sancaktar-logo.jpg'}
        logoAlt={item.team === 'ABRA Student Team' ? 'ABRA student team logo' : 'YTG SANCAKTAR student team logo'}/>)}
    </section>

    <section class="shell section" id="focus" aria-labelledby="skills-title">
      <div class="section-heading"><h2 id="skills-title">Technical Skills</h2></div>
      <div class="skills-grid">
        {homepageSkills.map((skill, index) => (
          <article class="skill-group">
            <div class="skill-heading">
              <span class="skill-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <h3>{skill.name}</h3>
            </div>
            <ul class="skill-items" aria-label={`${skill.name} skills`}>
              {skill.items.split(' · ').map(item => <li>{item}</li>)}
            </ul>
            {skill.learning && <p class="skill-learning">{skill.learning}</p>}
          </article>
        ))}
      </div>
    </section>

    <section class="shell section" id="education" aria-labelledby="education-title">
      <div class="section-heading"><h2 id="education-title">Education & Current Work</h2></div>
      <div class="education-current">
        <article class="education-card">
          <div class="education-identity">
            <img class="education-logo" src={url('images/subu-logo.svg')} alt="Sakarya University of Applied Sciences (SUBÜ) logo" width="76" height="76" loading="lazy"/>
            <div>
              <h3>B.Sc. Mechatronics Engineering</h3>
              <p class="education-university">Sakarya University of Applied Sciences — SUBÜ</p>
            </div>
          </div>
          <p class="education-date">Expected July 2027</p>
        </article>
        <article class="education-card current-work-card" id="current-work">
          <div class="current-work-heading">
            <p class="small-label">Graduation Project</p>
            <span class="status-badge">In Development</span>
          </div>
          <h3>Modular Embedded Flight-Control and Autonomous Navigation Platform for UAVs</h3>
          <p>Planned scope combines embedded flight control and autonomous navigation with sensor interfaces, telemetry and safety logic.</p>
        </article>
      </div>
    </section>

    <section class="shell contact-cta" aria-labelledby="contact-title">
      <div>
        <h2 id="contact-title">Contact</h2>
        <p>For engineering internship or job enquiries, email me.</p>
      </div>
      <Button href={`mailto:${site.email}`}><Icon name="mail" size={18}/>Email Mahmoud</Button>
    </section>
  </div>
</BaseLayout>

<style>
  /* Keep this balanced pair exclusive to the homepage. */
  .selected-projects-grid {
    align-items: stretch;
  }

  .selected-projects-grid > :global(.project-card) {
    display: flex;
    flex-direction: column;
    grid-column: auto;
    gap: 0;
    padding: 0;
    border: 0;
  }

  .selected-projects-grid :global(.project-body) {
    display: flex;
    flex: 1;
    flex-direction: column;
    max-width: none;
    padding: 24px 0 0;
  }

  .selected-projects-grid :global(.project-body h3) {
    font-size: clamp(1.5rem, 2.1vw, 1.875rem);
  }

  .selected-projects-grid :global(.badges) {
    margin-bottom: 20px;
  }

  .selected-projects-grid :global(.card-bottom) {
    margin-top: auto;
  }

  #focus .skills-grid {
    gap: 0 56px;
    border-bottom: 1px solid var(--line);
  }

  #focus .skill-group {
    padding: 25px 0 30px;
  }

  .skill-heading {
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    align-items: baseline;
    gap: 14px;
  }

  .skill-number {
    color: var(--muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  #focus .skill-group h3 {
    font-size: clamp(1.125rem, 1.6vw, 1.35rem);
    line-height: 1.35;
  }

  .skill-items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 22px;
    margin: 20px 0 0 46px;
    padding: 0;
    list-style: none;
  }

  .skill-items li {
    padding: 9px 0 8px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  #focus .skill-learning {
    margin: 14px 0 0 46px;
    max-width: 52ch;
    color: var(--muted);
    opacity: 0.78;
    font-size: 0.75rem !important;
    line-height: 1.65;
  }

  #education .education-current {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 0;
    align-items: stretch;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  #education .education-card {
    padding: 30px 38px 32px 0;
  }

  .education-identity {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr);
    align-items: center;
    gap: 22px;
  }

  .education-logo {
    display: block;
    width: 76px;
    height: 76px;
    object-fit: contain;
  }

  #education .education-card h3 {
    font-size: clamp(1.2rem, 1.65vw, 1.4rem);
    line-height: 1.4;
  }

  #education .education-university {
    margin-top: 9px;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  #education .education-date {
    margin: 25px 0 0 98px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    color: var(--ink);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  #education .current-work-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 30px 0 32px 42px;
  }

  #education .current-work-heading {
    margin-bottom: 18px;
  }

  #education .current-work-heading .small-label {
    color: var(--muted);
  }

  #education .status-badge {
    color: var(--ink);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  #education .current-work-card > p {
    max-width: 60ch;
    color: var(--muted);
  }

  @media (max-width: 600px) {
    .selected-projects-grid :global(.project-body) {
      padding-top: 20px;
    }

    #focus .skills-grid {
      gap: 0;
    }

    #focus .skill-group {
      padding: 22px 0 26px;
    }

    .skill-heading {
      grid-template-columns: 28px minmax(0, 1fr);
      gap: 12px;
    }

    .skill-items {
      grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
      gap: 0 18px;
      margin: 17px 0 0 40px;
    }

    #focus .skill-learning {
      margin-left: 40px;
    }

    #education .education-current {
      grid-template-columns: 1fr;
      gap: 0;
    }

    #education .education-card {
      padding: 24px 0 26px;
    }

    .education-identity {
      grid-template-columns: 62px minmax(0, 1fr);
      gap: 17px;
    }

    .education-logo {
      width: 62px;
      height: 62px;
    }

    #education .education-date {
      margin: 21px 0 0 79px;
      padding-top: 12px;
    }

    #education .current-work-card {
      padding: 26px 0 28px;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
