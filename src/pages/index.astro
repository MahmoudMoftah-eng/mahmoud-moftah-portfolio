---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import SocialLinks from '../components/SocialLinks.astro';
import {projects} from '../data/projects';
import {experience} from '../data/experience';
import {site, url} from '../data/site';

// Homepage summaries leave the full project data and case studies unchanged.
const selectedProjects = projects
  .filter(project => ['abra-hunter', 'stm32-robot-arm', 'yutpa-uav'].includes(project.slug))
  .map(project => {
    if (project.slug === 'abra-hunter') return {
      ...project,
      heroImage: 'projects/abra/abra-aircraft-overview.jpg',
      summary: 'Guidance and cascaded control integrated with Betaflight ANGLE mode, supported by flight testing and flight-log analysis.',
    };
    if (project.slug === 'stm32-robot-arm') return {
      ...project,
      period: '',
      summary: 'Embedded C firmware for STM32 cascade position–speed control, with pre-hardware MATLAB / Simulink evaluation of the control structure.',
    };
    if (project.slug === 'yutpa-uav') return {
      ...project,
      heroImage: 'projects/yutpa/yutpa-field-test.jpg',
    };
    return {...project};
  });

const homepageExperience = experience.map(item => ({
  ...item,
  summary: item.team === 'ABRA Student Team'
    ? 'Guidance & Control Lead for ABRA Hunter and Autonomous Flight Software Engineer for YUTPA.'
    : 'Developed the ROS2/Gazebo environment and integrated models and sensors to support localization, SLAM and navigation testing; member of the team awarded TEKNOFEST “Best Software Team”.',
}));

const homepageSkills = [
  {
    name: 'Embedded Systems & Electronics',
    items: 'STM32 · Embedded C firmware · Timers / interrupts · PWM / UART · Motor control / H-Bridge · ST-Link / Logic Analyzer',
  },
  {
    name: 'Control & Guidance',
    items: 'PID / cascade control · System identification · Pure Pursuit · Proportional Navigation · MATLAB / Simulink · Flight-log analysis',
  },
  {
    name: 'UAV & Robotics',
    items: 'Betaflight · ArduPilot · MAVLink / pymavlink · SITL · Mission Planner · ROS2 / Gazebo',
  },
  {
    name: 'Programming & Engineering Tools',
    items: 'Python · Git / GitHub · Linux · STM32CubeIDE / CubeMX',
    learning: 'Ongoing learning: broader C/C++ development and Embedded Linux.',
  },
];
---
<BaseLayout bodyClass="homepage-layout">
  <div class="homepage">
    <section class="shell hero">
      <div class="hero-copy">
        <p class="eyebrow">Mechatronics Engineering Student</p>
        <p class="hero-name">{site.name}</p>
        <h1>Embedded Systems · Control<br/><span>Autonomous Systems</span></h1>
        <p class="hero-description">Developing embedded firmware and UAV guidance and mission software through hardware integration, simulation and flight testing.</p>
        <p class="hero-meta">{site.location} · Expected graduation July 2027</p>
        <div class="hero-actions">
          <Button href={url('projects/')}>View Projects</Button>
          <Button href={url(site.cvAvailable ? site.cv : 'cv/')} secondary download={site.cvAvailable}>
            <Icon name="download" size={17}/>Download CV
          </Button>
        </div>
        <SocialLinks/>
      </div>
    </section>

    <section class="shell section" id="projects" aria-labelledby="projects-title">
      <div class="section-heading">
        <h2 id="projects-title">Selected Projects</h2>
        <a class="text-link" href={url('projects/')}>All projects</a>
      </div>
      <div class="project-grid">
        {selectedProjects.map((project, i) => (
          <ProjectCard project={project} number={i + 1} showDiagram={false}
            imageAlt={project.slug === 'abra-hunter' ? 'ABRA Hunter UAV on the ground during field testing at sunset.' : project.slug === 'yutpa-uav' ? 'YUTPA UAV during field testing.' : undefined}
            imageClass={project.slug === 'yutpa-uav' ? 'project-image-yutpa' : undefined}/>
        ))}
      </div>
    </section>

    <section class="shell section" id="experience" aria-labelledby="experience-title">
      <div class="section-heading"><h2 id="experience-title">Experience</h2></div>
      {homepageExperience.map(item => <ExperienceItem item={item}/>)}
    </section>

    <section class="shell section" id="focus" aria-labelledby="skills-title">
      <div class="section-heading"><h2 id="skills-title">Technical Skills</h2></div>
      <div class="skills-grid">
        {homepageSkills.map(skill => (
            <article class="skill-group">
              <h3>{skill.name}</h3>
            <p class="skill-list">{skill.items}</p>
            {skill.learning && <p class="skill-learning">{skill.learning}</p>}
          </article>
        ))}
      </div>
    </section>

    <section class="shell section" id="education" aria-labelledby="education-title">
      <div class="section-heading"><h2 id="education-title">Education & Current Work</h2></div>
      <div class="education-current">
        <article class="education-card">
          <h3>B.Sc. Mechatronics Engineering</h3>
          <p>Sakarya University of Applied Sciences — SUBÜ</p>
          <p>Expected July 2027</p>
        </article>
        <article class="education-card current-work-card" id="current-work">
          <div class="current-work-heading">
            <p class="small-label">Graduation Project</p>
            <span class="status-badge">In Development</span>
          </div>
          <h3>Modular Embedded Flight-Control and Autonomous Navigation Platform for UAVs</h3>
          <p>Planned scope combines embedded flight control and autonomous navigation with sensor interfaces, telemetry and safety logic.</p>
        </article>
      </div>
    </section>

    <section class="shell contact-cta" aria-labelledby="contact-title">
      <div>
        <h2 id="contact-title">Contact</h2>
        <p>For engineering internship or job enquiries, email me.</p>
      </div>
      <Button href={`mailto:${site.email}`}><Icon name="mail" size={18}/>Email Mahmoud</Button>
    </section>
  </div>
</BaseLayout>

<style>
  :global(.homepage-layout) {
    --bg: #1b1a18;
    --surface: #232220;
    --surface-raised: #2b2926;
    --ink: #eeeae2;
    --muted: #b7b2a9;
    --line: #44413b;
    --accent: #b8a17c;
  }
  :global(.homepage-layout .brand-caption) {
    font-family: inherit;
    letter-spacing: 0.05em;
  }
  :global(.homepage-layout .brand-mark) { border-radius: 2px; }
  :global(.homepage-layout .brand-mark span) { color: var(--ink); }
  .homepage :global(h1), .homepage :global(h2), .homepage :global(h3) {
    letter-spacing: -0.015em;
  }
  .homepage :global(.eyebrow), .homepage :global(.small-label) {
    font-family: inherit;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--muted);
  }
  .homepage :global(.hero) { display: block; padding-block: 76px 60px; }
  .homepage :global(.hero .eyebrow) { font-size: 0.875rem !important; }
  .homepage :global(.hero-name) { margin: 20px 0 18px; color: var(--ink); font-size: 1.125rem; }
  .homepage :global(.hero h1) {
    max-width: 1020px;
    font-size: clamp(2.125rem, 4.4vw, 3.75rem);
    line-height: 1.16;
    font-weight: 400;
    letter-spacing: -0.015em;
  }
  .homepage :global(.hero h1 span) { color: inherit; }
  .homepage :global(.hero-description) { max-width: 690px; margin-top: 26px; line-height: 1.75; }
  .hero-meta { margin-top: 18px; color: var(--muted); font-size: 0.875rem; }
  .homepage :global(.hero-actions) { margin-top: 30px; gap: 14px; }
  .homepage :global(.hero-socials) { margin-top: 24px; gap: 26px; }
  .homepage :global(.button) {
    border-radius: 2px;
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
    font-weight: 500;
    transition: background 0.15s, border-color 0.15s;
  }
  .homepage :global(.button:hover) { background: #d9d3c8; border-color: #d9d3c8; transform: none; }
  .homepage :global(.button-secondary) { background: transparent; border-color: var(--line); color: var(--ink); }
  .homepage :global(.button-secondary:hover) { background: var(--surface); border-color: var(--muted); }
  .homepage :global(.section) { padding-block: 60px; }
  .homepage :global(.section-heading) { align-items: baseline; margin-bottom: 34px; }
  .homepage :global(.section-heading h2) { font-size: clamp(1.75rem, 2.5vw, 2.25rem); font-weight: 400; line-height: 1.25; }
  .homepage :global(.text-link) { border-color: var(--muted); }
  .homepage :global(.text-link:hover) { border-color: var(--accent); }
  .homepage :global(.project-grid) { grid-template-columns: 1.05fr 1fr; align-items: start; gap: 34px 38px; }
  .homepage :global(.project-card) { border: 0; border-radius: 0; background: transparent; overflow: visible; transition: none; min-width: 0; }
  .homepage :global(.project-card:first-child) {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: 38px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--line);
  }
  .homepage :global(.project-card:first-child .project-body) { padding-top: 0; }
  .homepage :global(.project-card:nth-child(2)) { border-top: 1px solid var(--line); }
  .homepage :global(.project-body) { padding: 24px 0 0; }
  .homepage :global(.project-image) { height: auto; aspect-ratio: 4 / 3; object-position: center 45%; border-radius: 2px; }
  .homepage :global(.project-image-yutpa) { aspect-ratio: 4 / 3; object-position: center 50%; }
  .homepage :global(.card-category .eyebrow) { font-size: 0.8125rem !important; }
  .homepage :global(.card-category > span) { font-family: inherit; color: var(--muted); }
  .homepage :global(.project-body h3) { margin-block: 12px 9px; font-size: clamp(1.5rem, 2.1vw, 1.875rem); line-height: 1.25; }
  .homepage :global(.project-role) { color: var(--ink) !important; }
  .homepage :global(.project-summary) { min-height: 0; line-height: 1.75; }
  .homepage :global(.badges) { gap: 0; margin-top: 18px; }
  .homepage :global(.tech-badge) {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--muted);
    font-family: inherit;
    line-height: 1.8;
  }
  .homepage :global(.tech-badge:not(:last-child)::after) { content: ' / '; padding-inline: 7px; color: var(--muted); }
  .homepage :global(.card-bottom) { margin-top: 20px; padding-top: 16px; }
  .homepage :global(.card-bottom > span) { font-family: inherit; }
  .homepage :global(.experience-item) { grid-template-columns: 30% minmax(0, 1fr); padding-block: 26px 30px; }
  .homepage :global(.timeline-dot) { background: var(--muted); }
  .homepage :global(.experience-date p) { color: var(--ink); }
  .homepage :global(.experience-content h3) { line-height: 1.4; }
  .homepage :global(.team-name) { color: var(--ink); }
  .homepage :global(.experience-content > p) { line-height: 1.75; }
  .homepage :global(.skills-grid) { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px 52px; }
  .homepage :global(.skill-group) { min-width: 0; padding: 22px 0 0; border: 0; border-top: 1px solid var(--line); border-radius: 0; background: transparent; }
  .homepage :global(.skill-group h3) { margin: 0; font-size: 1.125rem; line-height: 1.45; }
  .homepage :global(.skill-list) { display: block; margin-top: 14px; max-width: 55ch; color: var(--muted); font-size: 0.9375rem; line-height: 1.9; }
  .homepage :global(.skill-learning) { margin-top: 14px; padding: 0; border: 0; color: var(--muted); line-height: 1.65; }
  .education-current { display: grid; grid-template-columns: 1fr 1.25fr; gap: 36px; }
  .education-card { min-width: 0; padding: 0; border: 0; border-radius: 0; background: transparent; }
  .education-card h3 { margin: 0; font-size: 1.25rem; line-height: 1.5; }
  .education-card p { margin: 14px 0 0; line-height: 1.75; }
  .current-work-card { border-left: 1px solid var(--line); padding-left: 36px; }
  .current-work-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 16px; margin-bottom: 16px; }
  .current-work-heading .small-label { margin: 0; font-size: 0.875rem !important; }
  .status-badge { display: inline; padding: 0; border: 0; border-radius: 0; color: var(--muted); font-size: 0.8125rem; line-height: 1.5; }
  .homepage :global(.contact-cta) { padding-block: 48px 58px; }
  .homepage :global(.contact-cta h2) { margin-top: 0; font-size: 2rem; font-weight: 400; }
  .homepage :global(.contact-cta p) { margin-top: 14px; }
  @media (max-width: 900px) {
    .homepage :global(.project-grid) { gap: 28px; }
    .homepage :global(.project-card:first-child) { gap: 26px; }
    .homepage :global(.skills-grid) { gap: 26px 30px; }
    .education-current { gap: 26px; }
    .current-work-card { padding-left: 26px; }
  }
  @media (max-width: 600px) {
    .homepage :global(.hero) { padding-block: 44px 40px; }
    .homepage :global(.hero h1) { font-size: clamp(2rem, 7.9vw, 2.625rem); }
    .homepage :global(.hero-description) { margin-top: 22px; }
    .homepage :global(.section) { padding-block: 40px; }
    .homepage :global(.section-heading) { margin-bottom: 26px; gap: 16px; }
    .homepage :global(.section-heading .text-link) { margin-top: 0; }
    .homepage :global(.project-grid) { grid-template-columns: 1fr; gap: 32px; }
    .homepage :global(.project-card:first-child) { display: block; grid-column: auto; padding-bottom: 26px; }
    .homepage :global(.project-card:first-child .project-body) { padding-top: 20px; }
    .homepage :global(.project-body) { padding-top: 20px; }
    .homepage :global(.experience-item) { grid-template-columns: 1fr; gap: 16px; }
    .homepage :global(.experience-links) { flex-wrap: wrap; }
    .homepage :global(.skills-grid), .education-current { grid-template-columns: 1fr; gap: 26px; }
    .current-work-card { border-left: 0; border-top: 1px solid var(--line); padding: 26px 0 0; }
    .homepage :global(.contact-cta) { padding-block: 40px 48px; }
  }
</style>
