---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import {site} from '../data/site';
---
<BaseLayout title="Contact Mahmoud Moftah | Engineering Opportunities" description="Get in touch with Mahmoud Moftah about embedded systems, UAVs, control engineering and autonomous systems opportunities."><header class="shell page-hero"><p class="eyebrow">CONTACT / LET’S CONNECT</p><h1>Let’s talk<br/><span class="accent-text">engineering.</span></h1><p class="page-intro">Interested in embedded systems, UAVs or autonomous systems? Feel free to get in touch about internships, graduate engineering opportunities or project work.</p></header><section class="shell contact-layout"><div class="contact-primary"><Icon name="mail" size={28}/><p class="small-label">EMAIL</p><a class="email-address" href={`mailto:${site.email}`}>{site.email}</a><p>The best way to reach me.</p><div class="contact-location"><Icon name="pin" size={18}/>{site.location}</div></div><div class="contact-profiles">{[{name:'GitHub',icon:'github',value:site.github,todo:'TODO_GITHUB_URL'},{name:'LinkedIn',icon:'linkedin',value:site.linkedin,todo:'TODO_LINKEDIN_URL'}].map(s=><div><Icon name={s.icon} size={21}/><div><h2>{s.name}</h2>{s.value?<a class="text-link" href={s.value} target="_blank" rel="noopener noreferrer">View profile (new tab)</a>:<p class="todo-note">{s.todo}</p>}</div></div>)}</div></section><section class="shell contact-bottom"><p class="eyebrow">AREAS OF INTEREST</p><p>Embedded Systems <span> / </span> Control & Guidance <span> / </span> UAV & Robotics</p></section></BaseLayout>
