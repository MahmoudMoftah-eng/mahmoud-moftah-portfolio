---
import type {Project} from '../data/projects';
import {url} from '../data/site';
import SystemDiagram from './SystemDiagram.astro';
import TechBadge from './TechBadge.astro';
interface Props { project:Project; number?: number; showDiagram?: boolean; imageAlt?: string; }
const {project:p,number,showDiagram = true,imageAlt} = Astro.props;
---
<article class:list={['project-card', !p.featured && 'secondary-card']}>
  {p.featured && (p.heroImage ? <img class="project-image" src={url(p.heroImage)} alt={imageAlt ?? `${p.shortTitle} project`} loading="lazy" width="720" height="360"/> : showDiagram && <SystemDiagram kind={p.diagram} compact/>)}
  <div class="project-body"><div class="card-category"><p class="eyebrow">{p.category}</p><span>{number && String(number).padStart(2,'0')}</span></div><h3><a href={url(`projects/${p.slug}/`)}>{p.shortTitle}</a></h3><p class="project-role">{p.role}</p><p class="project-summary">{p.summary}</p><div class="badges">{p.technologies.slice(0,4).map(label => <TechBadge label={label}/>)}</div><div class="card-bottom"><span>{p.period}</span><a class="text-link" href={url(`projects/${p.slug}/`)} aria-label={`Read ${p.shortTitle} case study`}>Read case study</a></div></div>
</article>
