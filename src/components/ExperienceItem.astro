---
import {url} from '../data/site';
import {experience} from '../data/experience';
interface Props {
  item: typeof experience[number];
  logo?: string;
  logoAlt?: string;
}
const {item, logo, logoAlt} = Astro.props;
---
<article class="experience-item">
  <div class="experience-date">
    <span class="timeline-dot"></span>
    <p>{item.period}</p>
    <span>{item.location}</span>
  </div>
  <div class="experience-content">
    {logo ? (
      <div class="experience-heading">
        <img class="team-logo" src={url(logo)} alt={logoAlt ?? `${item.team} logo`} width="64" height="64" loading="lazy"/>
        <div>
          <h3>{item.role}</h3>
          <p class="team-name">{item.team}</p>
        </div>
      </div>
    ) : (
      <>
        <h3>{item.role}</h3>
        <p class="team-name">{item.team}</p>
      </>
    )}
    <p>{item.summary}</p>
    <div class="experience-links">
      {item.links.map(link => <a class="text-link" href={url(`projects/${link.slug}/`)}>{link.label}</a>)}
    </div>
  </div>
</article>

<style>
  .experience-heading {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .experience-heading > div {
    min-width: 0;
  }

  .experience-heading .team-name {
    margin-top: 9px;
    color: var(--ink);
    line-height: 1.75;
  }

  .team-logo {
    display: block;
    flex: 0 0 64px;
    width: 64px;
    height: 64px;
    object-fit: contain;
  }

  @media (max-width: 600px) {
    .experience-heading {
      align-items: flex-start;
      gap: 14px;
    }

    .team-logo {
      flex-basis: 52px;
      width: 52px;
      height: 52px;
    }
  }
</style>
