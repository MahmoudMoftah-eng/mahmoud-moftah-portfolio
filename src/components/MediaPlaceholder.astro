---
import type {ProjectMedia} from '../data/projects';
import {url} from '../data/site';
interface Props { media:ProjectMedia; directory:string }
const {media} = Astro.props;
const isPhoto = media.kind === 'image' && /\.jpe?g$/i.test(media.src || '');
---
<figure class:list={['media-item', media.wide && 'media-item-wide', isPhoto && 'media-item-photo']}>{media.src ? (media.kind === 'video' ? <video controls preload="metadata" src={url(media.src)} aria-label={media.label}><track kind="captions"/></video> : media.kind === 'image' ? <div class:list={['media-image-frame', media.wide && 'media-image-scroll']}><img src={url(media.src)} alt={media.alt || media.label} loading="lazy" width={media.wide ? 2700 : 960} height={media.wide ? 880 : 600}/></div> : <a class="button button-secondary" href={url(media.src)} download>Download {media.label}</a>) : <div class="media-placeholder"><span class="placeholder-plus" aria-hidden="true">+</span><strong>{media.label}</strong><span>TODO · {media.kind === 'video' ? 'Video' : media.kind === 'document' ? 'Test records' : 'Original media'} to be added</span></div>}<figcaption>{media.src ? media.label : `Reserved for verified project ${media.kind === 'document' ? 'records' : 'media'}`}</figcaption></figure>
