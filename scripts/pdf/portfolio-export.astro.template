---
import '../styles/global.css';
import {projects, sectionId} from '../data/projects';
import {experience} from '../data/experience';
import {site, url} from '../data/site';

const title = 'Mahmoud Moftah | Engineering Portfolio PDF Export';
const description = 'Print edition of Mahmoud Moftah Mohamed’s engineering portfolio.';
const canonical = new URL(Astro.url.pathname, Astro.site);
const portfolioBase = new URL('https://mahmoud-moftah-portfolio.vercel.app/');
const external = (path: string) => new URL(path.replace(/^\/+/, ''), portfolioBase).href;
const selected = ['abra-hunter', 'yutpa-uav'].map(slug => projects.find(project => project.slug === slug)!);
const caseStudies = ['abra-hunter', 'stm32-robot-arm', 'yutpa-uav', 'ros2-usv'].map(slug => projects.find(project => project.slug === slug)!);
const abraDiagramViews = (src: string) => src.includes('system-architecture')
  ? [
      {x: 30, y: 20, width: 1370, height: 830, caption: 'Input lanes · 1 of 2'},
      {x: 1370, y: 20, width: 1310, height: 830, caption: 'Guidance and command flow · 2 of 2'},
    ]
  : [
      {x: 30, y: 0, width: 1065, height: 550, caption: 'Guidance references and path split · 1 of 2'},
      {x: 1075, y: 280, width: 1595, height: 510, caption: 'Angle, vertical and RC output paths · 2 of 2'},
    ];
const homepageSkills = [
  {name: 'Embedded Systems & Electronics', items: 'STM32 · Embedded C firmware · Timers / interrupts · PWM / UART · Motor control / H-Bridge · ST-Link / Logic Analyzer'},
  {name: 'Control & Guidance', items: 'PID / cascade control · System identification · Pure Pursuit · Proportional Navigation · MATLAB / Simulink · Flight-log analysis'},
  {name: 'UAV & Robotics', items: 'Betaflight · ArduPilot · MAVLink / pymavlink · SITL · Mission Planner · ROS2 / Gazebo'},
  {name: 'Programming & Engineering Tools', items: 'Python · Git / GitHub · Linux · STM32CubeIDE / CubeMX', learning: 'Ongoing learning: broader C/C++ development and Embedded Linux.'},
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#191919"/>
    <title>{title}</title>
    <meta name="description" content={description}/>
    <link rel="canonical" href={canonical}/>
    <meta property="og:title" content={title}/>
    <meta property="og:description" content={description}/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
  </head>
  <body class="pdf-export">
    <main class="pdf-document">
      <section class="pdf-intro" aria-label="Introduction">
        <div class="pdf-intro-grid">
          <div>
            <p class="eyebrow">Mechatronics Engineering Student</p>
            <p class="pdf-name">{site.name}</p>
            <h1>Embedded Systems · Control<br/>Autonomous Systems</h1>
            <p class="pdf-lead">Developing embedded firmware and UAV guidance and mission software through hardware integration, simulation and flight testing.</p>
            <p class="pdf-meta">{site.location} · Expected graduation July 2027</p>
            <div class="pdf-contact-list">
              <a href={`mailto:${site.email}`}>{site.email}</a>
              <a href={site.github}>GitHub</a>
              <a href={site.linkedin}>LinkedIn</a>
              <a href={external('')}>Online portfolio</a>
              {site.cvAvailable && <a href={external(site.cv)}>CV</a>}
            </div>
          </div>
          <img class="pdf-portrait" src={url('images/hero-portrait.jpg')} alt="Mahmoud Moftah wearing glasses and a dark jacket." width="682" height="1222"/>
        </div>
      </section>

      <section class="pdf-section pdf-selected" aria-labelledby="selected-title">
        <h2 id="selected-title">Selected Projects</h2>
        {selected.map(project => (
          <article class="pdf-feature">
            <img src={url(project.slug === 'abra-hunter' ? 'projects/abra/abra-aircraft-overview.jpg' : 'projects/yutpa/yutpa-field-test.jpg')}
              alt={project.slug === 'abra-hunter' ? 'ABRA Hunter UAV during field testing.' : 'YUTPA UAV during field testing.'}/>
            <div>
              <p class="eyebrow">{project.category}</p>
              <h3><a href={external(`projects/${project.slug}/`)}>{project.shortTitle}</a></h3>
              <p class="pdf-role">{project.role}</p>
              <p>{project.slug === 'abra-hunter' ? 'Guidance and cascaded control integrated with Betaflight ANGLE mode, supported by flight testing and flight-log analysis.' : project.summary}</p>
              <p class="pdf-small">{project.technologies.slice(0, 4).join(' / ')}</p>
            </div>
          </article>
        ))}
      </section>

      <section class="pdf-section" aria-labelledby="experience-title">
        <h2 id="experience-title">Engineering Experience</h2>
        {experience.map(item => (
          <article class="pdf-experience">
            <img src={url(item.team === 'ABRA Student Team' ? 'images/abra-team-logo.jpg' : 'images/ytg-sancaktar-logo.jpg')}
              alt={`${item.team} logo`}/>
            <div>
              <p class="pdf-small">{item.period}</p>
              <h3>{item.role}</h3>
              <p class="pdf-team">{item.team}</p>
              <p>{item.team === 'ABRA Student Team'
                ? 'Guidance & Control Lead for ABRA Hunter and Autonomous Flight Software Engineer for YUTPA.'
                : 'Developed the ROS2/Gazebo environment and integrated models and sensors to support localization, SLAM and navigation testing; member of the team awarded TEKNOFEST “Best Software Team”.'}</p>
              <p class="pdf-small">{item.links.map((link, index) => <><a href={external(`projects/${link.slug}/`)}>{link.label}</a>{index < item.links.length - 1 && ' / '}</>)}</p>
            </div>
          </article>
        ))}
      </section>

      <section class="pdf-section" aria-labelledby="skills-title">
        <h2 id="skills-title">Technical Skills</h2>
        <div class="pdf-skills">
          {homepageSkills.map((skill, index) => (
            <article>
              <p class="pdf-small">{String(index + 1).padStart(2, '0')}</p>
              <h3>{skill.name}</h3>
              <p>{skill.items}</p>
              {skill.learning && <p class="pdf-small">{skill.learning}</p>}
            </article>
          ))}
        </div>
      </section>

      <section class="pdf-section" aria-labelledby="education-title">
        <h2 id="education-title">Education & Current Work</h2>
        <div class="pdf-education">
          <article>
            <img src={url('images/subu-logo.svg')} alt="Sakarya University of Applied Sciences (SUBÜ) logo"/>
            <h3>B.Sc. Mechatronics Engineering</h3>
            <p>Sakarya University of Applied Sciences — SUBÜ</p>
            <p>Expected July 2027</p>
          </article>
          <article>
            <p class="pdf-small">Graduation Project · In Development</p>
            <h3>Modular Embedded Flight-Control and Autonomous Navigation Platform for UAVs</h3>
            <p>Planned scope combines embedded flight control and autonomous navigation with sensor interfaces, telemetry and safety logic.</p>
          </article>
        </div>
      </section>

      {caseStudies.map(project => (
        <article class="pdf-case" id={`case-${project.slug}`} aria-label={`${project.shortTitle} case study`}>
          <header class="pdf-case-header">
            <p class="eyebrow">{project.category}</p>
            <h2>{project.title}</h2>
            <p class="pdf-lead">{project.summary}</p>
            <dl class="pdf-facts">
              <div><dt>My role</dt><dd>{project.role}</dd></div>
              <div><dt>Context</dt><dd>{project.context}</dd></div>
              <div><dt>Period</dt><dd>{project.period}</dd></div>
            </dl>
          </header>
          {project.sections.map(section => (
            <section class="pdf-case-section" id={`${project.slug}-${sectionId(section.title)}`}>
              <h3>{section.title}</h3>
              {section.paragraphs?.map(paragraph => <p>{paragraph}</p>)}
              {section.items && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}
            </section>
          ))}
          <section class="pdf-case-section">
            <h3>Technologies</h3>
            <p class="pdf-small">{project.technologies.join(' / ')}</p>
          </section>
          {project.media.length > 0 && <section class="pdf-evidence-section">
            {project.media.filter(media => media.src).map(media => (
              project.slug === 'abra-hunter' && media.src?.endsWith('.svg')
                ? abraDiagramViews(media.src!).map(view => (
                    <figure class="pdf-evidence pdf-evidence-diagram pdf-evidence-detail">
                      <div class="pdf-diagram-slice" style={`aspect-ratio:${view.width}/${view.height};`}>
                        <img src={url(media.src!)} alt={`${media.alt || media.label} — ${view.caption}`}
                          style={`width:${2700 / view.width * 100}%;left:${-view.x / view.width * 100}%;top:${-view.y / view.height * 100}%;`}/>
                      </div>
                      <figcaption>{view.caption}</figcaption>
                    </figure>
                  ))
                : <figure class:list={['pdf-evidence', media.wide && 'pdf-evidence-wide', media.src?.endsWith('.svg') && 'pdf-evidence-diagram']}>
                    <img src={url(media.src!)} alt={media.alt || media.label}/>
                    <figcaption>{media.label}</figcaption>
                  </figure>
            ))}
          </section>}
        </article>
      ))}

      <section class="pdf-section pdf-about" aria-labelledby="about-title">
        <h2 id="about-title">About</h2>
        <img src={url('images/about-conference.jpg')} alt="Mahmoud Moftah at the TEKNOFEST 2026 Fighter UAV event area." width="4032" height="3024"/>
        <h3>I’m drawn to engineering where control software meets real hardware.</h3>
        <p>My strongest practical experience comes from UAV and embedded-control projects, where software interacts with real hardware, sensors, flight controllers and safety constraints. My project work covers embedded firmware, guidance and control, autonomous mission logic and system integration.</p>
        <p>I’m interested in aerospace, autonomous systems, robotics and defense technologies. I value careful implementation and testing as much as the algorithm itself, while continuing to develop my knowledge of Embedded Linux, PCB design, C / C++ and real-time embedded systems.</p>
      </section>

      <section class="pdf-section pdf-final-contact" aria-labelledby="contact-title">
        <h2 id="contact-title">Contact / Portfolio Links</h2>
        <p>For engineering internship or job enquiries, email me.</p>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <div class="pdf-contact-list">
          <a href={external('')}>Portfolio website</a>
          <a href={site.github}>GitHub</a>
          <a href={site.linkedin}>LinkedIn</a>
          {site.cvAvailable && <a href={external(site.cv)}>CV</a>}
        </div>
      </section>
    </main>
  </body>
</html>

<style is:global>
  @page { size: A4; margin: 16mm 16mm 18mm; background: #191919; }
  @page { @bottom-right { content: counter(page); color: #b3b3b0; font: 9pt "Segoe UI", Arial, sans-serif; } }
   @page pdf-diagram { size: A4 landscape; margin: 9mm 7mm 12mm; background: #191919; }
  @page pdf-diagram { @bottom-right { content: counter(page); color: #b3b3b0; font: 9pt "Segoe UI", Arial, sans-serif; } }
  html { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
  body.pdf-export { background: #191919; color: #efefec; font: 14px/1.55 "Segoe UI", Arial, sans-serif; }
  .pdf-document { width: min(100% - 48px, 980px); margin: 0 auto; padding: 32px 0 80px; }
  .pdf-export h1, .pdf-export h2, .pdf-export h3 { color: #efefec; font-weight: 400; letter-spacing: -0.015em; }
  .pdf-export h1 { font-size: 42px; line-height: 1.14; }
  .pdf-export h2 { font-size: 31px; line-height: 1.18; }
  .pdf-export h3 { font-size: 20px; line-height: 1.25; }
  .pdf-export p, .pdf-export li, .pdf-export dd { color: #b3b3b0; }
  .pdf-export a { color: #efefec; border-bottom: 1px solid #6b6b6b; }
  .pdf-export .eyebrow, .pdf-small, .pdf-meta { color: #b3b3b0; font-size: 12px; }
  .pdf-intro { min-height: 820px; display: flex; align-items: center; }
  .pdf-intro-grid { display: grid; grid-template-columns: 1.65fr 0.75fr; gap: 42px; align-items: center; width: 100%; }
  .pdf-name { color: #efefec !important; font-size: 19px; margin: 16px 0; }
  .pdf-lead { font-size: 17px; line-height: 1.6; margin-top: 22px; }
  .pdf-meta { margin-top: 20px; }
  .pdf-contact-list { display: flex; flex-wrap: wrap; gap: 12px 22px; margin-top: 26px; font-size: 13px; }
  .pdf-portrait { display: block; width: 100%; height: auto; }
  .pdf-section { border-top: 1px solid #3c3c3c; padding-top: 28px; margin-top: 46px; }
  .pdf-section > h2 { margin-bottom: 26px; }
  .pdf-feature { display: grid; grid-template-columns: 270px 1fr; gap: 28px; align-items: center; border-top: 1px solid #3c3c3c; padding: 25px 0; }
  .pdf-feature img { display: block; max-width: 100%; max-height: 270px; width: auto; height: auto; }
  .pdf-feature h3 { margin: 6px 0; }
  .pdf-feature p + p { margin-top: 9px; }
  .pdf-role, .pdf-team { color: #efefec !important; }
  .pdf-experience { display: grid; grid-template-columns: 60px 1fr; gap: 22px; border-top: 1px solid #3c3c3c; padding: 22px 0; }
  .pdf-experience img { display: block; width: 60px; height: 60px; object-fit: contain; }
  .pdf-experience h3 { margin: 5px 0; }
  .pdf-experience p + p { margin-top: 8px; }
  .pdf-skills, .pdf-education { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 38px; }
  .pdf-skills article, .pdf-education article { border-top: 1px solid #3c3c3c; padding-top: 16px; }
  .pdf-skills h3, .pdf-education h3 { margin: 8px 0 10px; }
  .pdf-skills p + p, .pdf-education p + p { margin-top: 12px; }
  .pdf-education img { width: 55px; height: 55px; object-fit: contain; }
  .pdf-case { border-top: 1px solid #3c3c3c; margin-top: 55px; padding-top: 28px; }
  .pdf-case-header .pdf-lead { max-width: 700px; }
  .pdf-facts { display: grid; grid-template-columns: 1.1fr 2fr 0.9fr; gap: 18px; border-top: 1px solid #3c3c3c; padding-top: 15px; margin: 25px 0 0; }
  .pdf-facts dt { color: #b3b3b0; font-size: 11px; margin-bottom: 5px; }
  .pdf-facts dd { color: #efefec; margin: 0; }
  .pdf-case-section { margin-top: 28px; }
  .pdf-case-section h3, .pdf-evidence-section h3 { margin-bottom: 12px; }
  .pdf-case-section p { max-width: 78ch; }
  .pdf-case-section p + p { margin-top: 10px; }
  .pdf-case-section ul { padding-left: 18px; margin: 12px 0 0; }
  .pdf-case-section li { margin-top: 5px; }
  .pdf-evidence-section { border-top: 1px solid #3c3c3c; margin-top: 30px; padding-top: 20px; }
  .pdf-evidence { margin: 20px 0 28px; }
  .pdf-evidence img { display: block; max-width: 100%; max-height: 700px; width: auto; height: auto; border: 1px solid #3c3c3c; }
  .pdf-evidence figcaption { color: #b3b3b0; font-size: 11px; line-height: 1.5; margin-top: 7px; }
  .pdf-about img { display: block; width: min(100%, 720px); height: auto; margin-bottom: 25px; }
  .pdf-about h3 { max-width: 700px; margin-bottom: 18px; }
  .pdf-about p { max-width: 75ch; margin-top: 12px; }
  .pdf-final-contact { padding-bottom: 28px; }
  .pdf-final-contact > a { display: inline-block; margin-top: 12px; font-size: 18px; }
  @media print {
    html, body.pdf-export { width: auto; min-height: 0; background: #191919 !important; }
    body.pdf-export { font-size: 10pt; line-height: 1.42; }
    .pdf-document { width: auto; margin: 0; padding: 0; }
    .pdf-export h1 { font-size: 27pt; }
    .pdf-export h2 { font-size: 19pt; }
    .pdf-export h3 { font-size: 13pt; }
    .pdf-intro { min-height: 240mm; }
    .pdf-intro-grid { grid-template-columns: 1.65fr 0.75fr; gap: 12mm; }
    .pdf-lead { font-size: 11pt; }
    .pdf-section { margin-top: 11mm; padding-top: 5mm; }
    .pdf-feature { grid-template-columns: 55mm 1fr; gap: 7mm; padding: 5mm 0; break-inside: avoid; }
    .pdf-feature img { max-width: 55mm; max-height: 74mm; }
    .pdf-experience { grid-template-columns: 14mm 1fr; gap: 5mm; break-inside: avoid; }
    .pdf-experience img { width: 14mm; height: 14mm; }
    .pdf-skills article, .pdf-education article { break-inside: avoid; }
    .pdf-skills, .pdf-education { gap: 7mm 9mm; }
    .pdf-education img { width: 13mm; height: 13mm; }
    .pdf-case { break-before: page; margin-top: 0; padding-top: 0; border: 0; }
    .pdf-case-header { break-after: avoid; }
    .pdf-case-section { margin-top: 6mm; }
    #case-ros2-usv .pdf-case-section { margin-top: 2mm; }
    #case-ros2-usv .pdf-case-section li { margin-top: 3px; }
    .pdf-case-section h3, .pdf-evidence-section h3, .pdf-section > h2 { break-after: avoid; }
    .pdf-case-section li, .pdf-case-section p { orphans: 3; widows: 3; }
     .pdf-evidence-section { border: 0; margin-top: 3mm; padding-top: 0; }
     .pdf-evidence { break-inside: avoid; margin: 5mm 0 7mm; }
     .pdf-evidence img { width: 100%; max-height: 210mm; object-fit: contain; }
     .pdf-evidence-diagram { page: pdf-diagram; break-before: page; break-after: page; }
     .pdf-evidence-diagram img { width: 100%; max-width: 100%; max-height: 155mm; }
     .pdf-evidence-detail { margin: 0; }
     .pdf-diagram-slice { position: relative; overflow: hidden; width: 100%; border: 1px solid #3c3c3c; }
     .pdf-diagram-slice img { position: absolute; display: block; max-width: none; max-height: none; height: auto; border: 0; object-fit: initial; }
    .pdf-about { break-before: page; }
    .pdf-about img { max-height: 90mm; width: auto; max-width: 100%; }
    .pdf-final-contact { break-inside: avoid; }
    a { text-decoration: none; }
  }
</style>
